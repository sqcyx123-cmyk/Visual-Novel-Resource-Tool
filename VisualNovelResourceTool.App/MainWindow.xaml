<Window x:Class="VisualNovelResourceTool.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="视觉小说资源工具" Height="820" Width="1280" MinHeight="680" MinWidth="1000" Background="#F5F7FB" FontFamily="Microsoft YaHei UI" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
 <Window.Resources><Style TargetType="Button"><Setter Property="Padding" Value="15,8"/><Setter Property="Margin" Value="0,0,8,0"/></Style></Window.Resources>
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="视觉小说资源工具" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="识别、预览并安全提取 2D 视觉小说资源；原游戏始终只读。" Foreground="#667085" Margin="0,5,0,14"/></StackPanel>
  <Border Grid.Row="1" Background="White" CornerRadius="9" Padding="13" BorderBrush="#E4E7EC" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="PathBox" Height="36" IsReadOnly="True" VerticalContentAlignment="Center" Padding="9,0" Text="拖入游戏目录、RPA 或 XP3"/><StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0"><Button Content="选择游戏目录" Click="ChooseFolder_Click"/><Button Content="选择资源包" Click="ChooseArchive_Click"/><Button Content="反编译 RPyC" Click="Decompile_Click" Margin="0"/></StackPanel></Grid></Border>
  <Border Grid.Row="2" Background="White" CornerRadius="9" Padding="13" BorderBrush="#E4E7EC" BorderThickness="1" Margin="0,10,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="CustomOutputBox" Content="使用固定的默认输出位置" VerticalAlignment="Center" Checked="OutputSetting_Changed" Unchecked="OutputSetting_Changed"/><TextBox x:Name="OutputRootBox" Grid.Column="1" Margin="12,0" Height="34" VerticalContentAlignment="Center" IsReadOnly="True"/><Button Grid.Column="2" Content="更改位置" Click="ChooseOutput_Click" Margin="0"/></Grid></Border>
  <Grid Grid.Row="3" Margin="0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
   <Border Background="White" CornerRadius="9" Padding="12" BorderBrush="#E4E7EC" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="识别结果" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/><DataGrid x:Name="ResultsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="ResultsGrid_SelectionChanged" BorderThickness="0"><DataGrid.Columns><DataGridTextColumn Header="名称" Binding="{Binding DisplayName}" Width="*"/><DataGridTextColumn Header="格式" Binding="{Binding Format}" Width="110"/><DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="75"/></DataGrid.Columns></DataGrid></Grid></Border>
   <Border Grid.Column="1" Margin="14,0" Background="White" CornerRadius="9" Padding="12" BorderBrush="#E4E7EC" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="155"/></Grid.ColumnDefinitions><TextBox x:Name="FilterBox" Height="34" Padding="8,0" VerticalContentAlignment="Center" TextChanged="Filter_Changed" ToolTip="按文件名或扩展名筛选"/><ComboBox x:Name="CategoryBox" Grid.Column="1" Height="34" Margin="8,0,0,0" SelectionChanged="Category_Changed" SelectedValuePath="Tag" SelectedValue="Images"><ComboBoxItem Content="图片（全部）" Tag="Images"/><ComboBoxItem Content="CG / 事件图" Tag="EventCg"/><ComboBoxItem Content="背景" Tag="Background"/><ComboBoxItem Content="角色 / 立绘图层" Tag="CharacterLayer"/><ComboBoxItem Content="动图 / 视频" Tag="Animation"/><ComboBoxItem Content="界面图片" Tag="Ui"/><ComboBoxItem Content="其他图片" Tag="OtherImage"/><ComboBoxItem Content="全部资源（高级）" Tag="All"/></ComboBox></Grid><TextBlock x:Name="EntryCountText" Grid.Row="1" Foreground="#667085" Margin="0,7"/><ListBox x:Name="EntriesList" Grid.Row="2" SelectionMode="Extended" DisplayMemberPath="Name" SelectionChanged="Entries_SelectionChanged"/><StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0"><Button x:Name="ExtractAllButton" Content="提取当前分类" Click="ExtractAll_Click" IsEnabled="False"/><Button x:Name="ExtractSelectedButton" Content="提取选中项" Click="ExtractSelected_Click" IsEnabled="False"/><Button x:Name="ThumbnailButton" Content="缩略图" Click="Thumbnail_Click" IsEnabled="False"/><Button x:Name="CancelButton" Content="取消" Click="Cancel_Click" IsEnabled="False" Margin="0"/></StackPanel></Grid></Border>
   <Border Grid.Column="2" Background="White" CornerRadius="9" Padding="14" BorderBrush="#E4E7EC" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="DetailTitle" Text="详情" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="DetailDescription" Grid.Row="1" Margin="0,9" TextWrapping="Wrap" Foreground="#475467"/><Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="70"/></Grid.RowDefinitions><Border Background="#F2F4F7" CornerRadius="6"><Grid><Image x:Name="PreviewImage" Stretch="Uniform" Margin="5"/><MediaElement x:Name="PreviewVideo" Stretch="Uniform" Margin="5" Visibility="Collapsed" LoadedBehavior="Manual" UnloadedBehavior="Manual" IsMuted="True" MediaEnded="PreviewVideo_Ended" MediaFailed="PreviewVideo_Failed"/></Grid></Border><ItemsControl x:Name="NearbyStrip" Grid.Row="1" Margin="0,7,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding Entry}" Click="Nearby_Click" Padding="2" Margin="2,0"><Image Source="{Binding Source}" Stretch="Uniform" ToolTip="{Binding Name}"/></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid><TextBlock x:Name="OutputPreviewText" Grid.Row="3" Margin="0,10" TextWrapping="Wrap" Foreground="#344054"/><StackPanel Grid.Row="4"><CheckBox x:Name="ChineseFolderBox" Content="输出目录添加中文注释（如 bg-背景）" Checked="ChineseFolder_Changed" Unchecked="ChineseFolder_Changed"/><CheckBox x:Name="OverwriteBox" Content="覆盖同名文件" Margin="0,7,0,0"/></StackPanel></Grid></Border>
  </Grid>
  <Border Grid.Row="4" Background="White" CornerRadius="7" Padding="11" BorderBrush="#E4E7EC" BorderThickness="1"><StackPanel><TextBlock x:Name="StatusText" Text="就绪" TextWrapping="Wrap"/><ProgressBar x:Name="Progress" Height="7" Margin="0,7,0,0" Visibility="Collapsed"/></StackPanel></Border>
 </Grid>
</Window>
